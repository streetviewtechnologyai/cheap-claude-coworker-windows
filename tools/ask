#!/usr/bin/env python3
"""Delegate bulk reading to the worker model. Returns a summary to Claude.

The active worker provider is configured in config.py (ACTIVE_PROVIDER) and can
be switched with `coworker-config use <name>` or by setting WORKER_PROVIDER.
max-tokens must cover both reasoning + answer for thinking models.
"""
import argparse
import os
import pathlib
import sys

# Make the package root importable so we can load config.py regardless of CWD.
_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

# Force UTF-8 on stdout/stderr so model output containing arrows, em-dashes,
# checkmarks, etc. doesn't crash on Windows where the default is cp1252.
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, OSError):
        pass

import config as worker_config  # noqa: E402
from openai import OpenAI  # noqa: E402

p = argparse.ArgumentParser(description="Ask the worker model to read and summarize files")
p.add_argument("--paths", nargs="+", required=True, help="Files to read")
p.add_argument("--question", required=True, help="What to extract/answer")
p.add_argument("--max-tokens", type=int, default=8192,
               help="Total token budget (reasoning + answer)")
p.add_argument("--provider", default=None,
               help="Provider name from config.py (overrides ACTIVE_PROVIDER)")
p.add_argument("--model", default=None, help="Override model id")
args = p.parse_args()

cfg = worker_config.resolve(args.provider)
if not cfg["api_key"]:
    sys.exit(
        f"[error] No API key for provider {cfg['name']!r}. "
        f"Set the 'api_key' field in config.py."
    )

client = OpenAI(api_key=cfg["api_key"], base_url=cfg["base_url"])

docs = []
for path in args.paths:
    content = pathlib.Path(path).read_text(errors="replace")
    docs.append(f"<file path='{path}'>\n{content}\n</file>")
corpus = "\n\n".join(docs)

resp = client.chat.completions.create(
    model=args.model or cfg["model"],
    messages=[
        {"role": "system", "content": (
            "You are a precise code/document analyst. Read the provided files "
            "and answer the question concisely. Quote file paths and line "
            "numbers when relevant. Output structured bullets, not prose. "
            "Keep your answer under 800 words."
        )},
        {"role": "user", "content": f"<corpus>\n{corpus}\n</corpus>"},
        {"role": "user", "content": args.question},
    ],
    max_tokens=args.max_tokens,
)

answer = resp.choices[0].message.content
if answer:
    print(answer)
else:
    print("[ERROR: worker ran out of tokens during reasoning. "
          "Try --max-tokens 16384]", file=sys.stderr)
    sys.exit(1)

u = resp.usage
cached = getattr(getattr(u, 'prompt_tokens_details', None), 'cached_tokens', 0) or 0
print(f"\n[{cfg['name']}: {u.prompt_tokens} in ({cached} cached) / "
      f"{u.completion_tokens} out | finish: {resp.choices[0].finish_reason}]",
      file=sys.stderr)
