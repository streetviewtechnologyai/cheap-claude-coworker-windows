#!/usr/bin/env python3
"""Switch or inspect the active worker provider in config.py.

Usage:
  coworker-config list                  # show all providers and the active one
  coworker-config show                  # show the resolved active config
  coworker-config use <provider-name>   # set ACTIVE_PROVIDER in config.py
"""
import argparse
import os
import pathlib
import re
import sys

_ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

import config as worker_config  # noqa: E402


def cmd_list() -> int:
    active = worker_config.ACTIVE_PROVIDER
    print(f"Active: {active}\n")
    for name, p in worker_config.PROVIDERS.items():
        marker = "*" if name == active else " "
        print(f" {marker} {name:20s}  {p['label']:25s}  model={p['model']}")
    return 0


def cmd_show() -> int:
    cfg = worker_config.resolve()
    masked = (cfg["api_key"][:4] + "..." + cfg["api_key"][-4:]) if cfg["api_key"] else "(missing)"
    print(f"name      : {cfg['name']}")
    print(f"label     : {cfg['label']}")
    print(f"base_url  : {cfg['base_url']}")
    print(f"model     : {cfg['model']}")
    print(f"api_key   : {masked} (from config.py)")
    if not cfg["api_key"]:
        print("\n[warning] No API key set. Add one to the 'api_key' field in config.py.")
        return 1
    return 0


def cmd_use(name: str) -> int:
    if name not in worker_config.PROVIDERS:
        print(f"Unknown provider: {name!r}. Known: {', '.join(worker_config.PROVIDERS)}",
              file=sys.stderr)
        return 2
    config_path = pathlib.Path(worker_config.__file__)
    text = config_path.read_text(encoding="utf-8")
    new_text, n = re.subn(
        r'^(ACTIVE_PROVIDER\s*=\s*)["\'][^"\']*["\']',
        lambda m: f'{m.group(1)}"{name}"',
        text,
        count=1,
        flags=re.MULTILINE,
    )
    if n != 1:
        print("[error] could not find ACTIVE_PROVIDER in config.py", file=sys.stderr)
        return 3
    config_path.write_text(new_text, encoding="utf-8")
    print(f"Active provider set to: {name}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage the active worker provider")
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("list", help="List available providers")
    sub.add_parser("show", help="Show the resolved active configuration")
    p_use = sub.add_parser("use", help="Set the active provider")
    p_use.add_argument("name", help="Provider key from config.py")
    args = parser.parse_args()

    if args.cmd == "list" or args.cmd is None:
        return cmd_list()
    if args.cmd == "show":
        return cmd_show()
    if args.cmd == "use":
        return cmd_use(args.name)
    return 1


if __name__ == "__main__":
    sys.exit(main())
